{
  "name": "odoo-rewrite",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.6-canary.1",
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.6-canary.1"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "workers/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "dev": "turbo run dev",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint": "bun lint --no-script --max-warnings=0 --allow-unsupported",
    "lint:boundaries": "depcruise packages",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "dependency-cruiser": "^18.9.0",
    "turbo": "^2.11.13",
    "typescript": "7.0.2"
  }
}
