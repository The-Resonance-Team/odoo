{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalDependencies": [
    "package.json",
    "bun.lock",
    "turbo.json",
    ".oxfmtrc.json",
    ".oxlintrc.json",
    ".dependency-cruiser.cjs"
  ],
  "tasks": {
    "generate": {
      "outputs": ["generated/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
